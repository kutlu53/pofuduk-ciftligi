  "chunks": [
    {"id": "c01", "en": "How are you?", "tr": "Nasılsın?", "skills": ["L", "S"]},
    {"id": "c02", "en": "I'm good, thanks!", "tr": "İyiyim, teşekkürler!", "skills": ["S"]},
    {"id": "c03", "en": "Good evening! Good afternoon! Good night!", "tr": "İyi akşamlar / İyi günler / İyi geceler", "skills": ["L", "S"]},
    {"id": "c04", "en": "Who's this?", "tr": "Bu kim?", "skills": ["L", "S"]},
    {"id": "c05", "en": "This is Mr. Blue.", "tr": "Bu Bay Blue.", "skills": ["R", "W"]},
    {"id": "c06", "en": "Where is Daphne? She's in the library.", "tr": "Daphne nerede? Kütüphanede.", "skills": ["L", "R"]},
    {"id": "c07", "en": "What month is it now? It's September.", "tr": "Şimdi hangi ay? Eylül.", "skills": ["L", "S", "R"]},
    {"id": "c08", "en": "How old are you? I'm 8 years old.", "tr": "Kaç yaşındasın? 8 yaşındayım.", "skills": ["L", "S", "W"]},
    {"id": "c09", "en": "When's your birthday? It's in July.", "tr": "Doğum günün ne zaman? Temmuzda.", "skills": ["L", "S", "R"]},
    {"id": "c10", "en": "Whose birthday is in October?", "tr": "Kimin doğum günü ekimde?", "skills": ["L", "R"]},
    {"id": "c11", "en": "Is there a nurse at school?", "tr": "Okulda hemşire var mı?", "skills": ["R", "G"]},
    {"id": "c12", "en": "How many caretakers are there?", "tr": "Kaç hizmetli var?", "skills": ["L", "R"]},
    {"id": "c13", "en": "You must follow the rules at school.", "tr": "Okulda kurallara uymalısın.", "skills": ["R", "G"]},
    {"id": "c14", "en": "You mustn't run in the corridor.", "tr": "Koridorda koşmamalısın.", "skills": ["R", "G"]}
  ],
  "social": [
