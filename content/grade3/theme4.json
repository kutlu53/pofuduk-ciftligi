  "chunks": [
    {"id": "c01", "en": "How old is your mother? She's thirty-five years old.", "tr": "Annen kaç yaşında? Otuz beş yaşında.", "skills": ["L", "S", "R"]},
    {"id": "c02", "en": "Is this her birthday today? Yes, it's her birthday today.", "tr": "Bugün onun doğum günü mü? Evet.", "skills": ["L", "R"]},
    {"id": "c03", "en": "What does she do every morning? She prepares breakfast every morning.", "tr": "Her sabah ne yapar? Kahvaltı hazırlar.", "skills": ["L", "R", "W"]},
    {"id": "c04", "en": "What do you do at home? I clean my room every morning.", "tr": "Evde ne yaparsın? Her sabah odamı temizlerim.", "skills": ["L", "S", "W"]},
    {"id": "c05", "en": "My father can cook.", "tr": "Babam yemek yapabilir.", "skills": ["R", "W", "G"]},
    {"id": "c06", "en": "My father can't cook.", "tr": "Babam yemek yapamaz.", "skills": ["R", "W", "G"]},
    {"id": "c07", "en": "Could you help me, please?", "tr": "Bana yardım edebilir misin lütfen?", "skills": ["L", "S"]},
    {"id": "c08", "en": "How often do you play chess? I sometimes play chess.", "tr": "Ne sıklıkla satranç oynarsın? Bazen.", "skills": ["L", "R", "G"]}
  ],
