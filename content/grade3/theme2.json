  "chunks": [
    {"id": "c01", "en": "Open your book, please!", "tr": "Kitabını aç lütfen!", "skills": ["L", "R"]},
    {"id": "c02", "en": "Close your book, please!", "tr": "Kitabını kapat lütfen!", "skills": ["L", "R"]},
    {"id": "c03", "en": "Listen and repeat, please!", "tr": "Dinle ve tekrar et lütfen!", "skills": ["L", "S"]},
    {"id": "c04", "en": "Take your seat, please!", "tr": "Yerine otur lütfen!", "skills": ["L"]},
    {"id": "c05", "en": "What time is it? It's five o'clock.", "tr": "Saat kaç? Saat beş.", "skills": ["L", "S", "R"]},
    {"id": "c06", "en": "What lesson is it now? It's Maths.", "tr": "Şimdi hangi ders? Matematik.", "skills": ["L", "S", "R"]},
    {"id": "c07", "en": "How's the weather today? It's raining today.", "tr": "Bugün hava nasıl? Yağmurlu.", "skills": ["L", "S", "R"]},
    {"id": "c08", "en": "What are they? They are rulers.", "tr": "Bunlar ne? Cetveller.", "skills": ["L", "S", "R"]},
    {"id": "c09", "en": "Is there a Maths lesson on Monday?", "tr": "Pazartesi matematik dersi var mı?", "skills": ["R", "G"]},
    {"id": "c10", "en": "How many rulers are there on the table? There are two rulers.", "tr": "Masada kaç cetvel var? İki cetvel var.", "skills": ["L", "R", "W"]},
    {"id": "c11", "en": "How many pencils have you got? I've got two pencils.", "tr": "Kaç kalemin var? İki kalemim var.", "skills": ["L", "S", "W"]},
    {"id": "c12", "en": "There is a pen on the desk.", "tr": "Masanın üstünde bir kalem var.", "skills": ["R", "W"]}
  ],
  "social": [
    {"en": "Let's start the lesson!", "tr": "Derse başlayalım!"},
    {"en": "That's correct!", "tr": "Doğru!"},
    {"en": "Have you finished?", "tr": "Bitirdin mi?"},
    {"en": "Last five minutes!", "tr": "Son beş dakika!"},
    {"en": "Nice job! / Great job!", "tr": "Aferin! / Harika iş!"},
    {"en": "Thank you!", "tr": "Teşekkürler!"},
    {"en": "You're welcome!", "tr": "Rica ederim!"},
    {"en": "Time's over!", "tr": "Süre bitti!"},
    {"en": "Perfect!", "tr": "Mükemmel!"},
    {"en": "Look outside!", "tr": "Dışarı bak!"},
    {"en": "Turn on the lights!", "tr": "Işıkları aç!"},
    {"en": "You look great!", "tr": "Harika görünüyorsun!"},
    {"en": "What nice weather!", "tr": "Ne güzel hava!"},
    {"en": "It's freezing!", "tr": "Buz gibi!"},
